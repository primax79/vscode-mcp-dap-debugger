{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Async Hang Sample",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Attach to Async Hang (5678)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "justMyCode": false
        }
    ]
}
