{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Worker Pool",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/main.js",
            "autoAttachChildProcesses": true
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Attach to Worker Pool",
            "port": 9229,
            "restart": false,
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
