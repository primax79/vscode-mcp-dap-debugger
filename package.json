{
  "name": "vscode-debug-mcp",
  "displayName": "VSCode Debug MCP",
  "description": "VS Code extension and CLI that expose VS Code's Debug Adapter Protocol as MCP tools for AI coding agents",
  "version": "0.1.0",
  "publisher": "primax79",
  "license": "GPL-3.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/primax79/mcp-debug-tools",
    "directory": "vscode-debug-mcp"
  },
  "keywords": [
    "vscode-extension",
    "debugging",
    "mcp",
    "dap",
    "debug-adapter-protocol",
    "model-context-protocol",
    "cli-tool"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Debuggers",
    "AI",
    "Testing"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "bin": {
    "vscode-debug-mcp": "./out/cli.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "vscode-debug-mcp.addUnboundBreakpoint",
        "title": "Add Breakpoint",
        "category": "Debug MCP"
      },
      {
        "command": "vscode-debug-mcp.openMonitorPanel",
        "title": "Open Monitor Panel",
        "category": "Debug MCP"
      },
      {
        "command": "vscode-debug-mcp.startServer",
        "title": "Start MCP Server",
        "category": "Debug MCP"
      },
      {
        "command": "vscode-debug-mcp.stopServer",
        "title": "Stop MCP Server",
        "category": "Debug MCP"
      }
    ],
    "configuration": {
      "title": "VSCode Debug MCP",
      "properties": {
        "vscodeDebugMcp.injectAgentSkills": {
          "type": "boolean",
          "default": true,
          "description": "Write the AI-agent SKILL.md guide into .claude/skills and .gemini/skills in the workspace so coding agents auto-discover how to use this tool."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "vscode:prepublish": "npm run build",
    "lint": "eslint src",
    "pretest": "npm run build && npm run lint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.1",
    "commander": "^12.1.0",
    "express": "^4.21.2",
    "jsonc-parser": "^3.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  }
}
